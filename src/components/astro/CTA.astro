---
import Button from "./Button.astro";
import CallButton from "./CallButton.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  eyebrow = "Book in minutes",
  title,
  description,
  primaryLabel = "Book AC Service",
  primaryHref = "/book-service",
} = Astro.props;
---

<section class="relative overflow-hidden bg-navy-950 py-20 sm:py-24">
  <div class="technical-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -right-24 top-1/2 h-[420px] w-[420px] -translate-y-1/2 rounded-full bg-accent-500/10 blur-[100px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-wide relative text-center">
    <span class="eyebrow-dark" data-reveal>
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
      {eyebrow}
    </span>
    <h2 class="mx-auto mt-5 max-w-2xl text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-[2.75rem]" data-reveal data-reveal-delay="1">
      {title}
    </h2>
    {description && (
      <p class="mx-auto mt-4 max-w-xl text-base text-ice-100/75 sm:text-lg" data-reveal data-reveal-delay="2">
        {description}
      </p>
    )}
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4" data-reveal data-reveal-delay="3">
      <Button href={primaryHref} variant="primary" size="lg" icon="arrow-right">
        {primaryLabel}
      </Button>
      <CallButton variant="outline" />
    </div>
  </div>
</section>
