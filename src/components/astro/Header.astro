---
import { business } from "@config/business";
import Icon from "./Icon.astro";
import Button from "./Button.astro";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Pricing", href: "/pricing" },
  { label: "Service Areas", href: "/service-areas" },
  { label: "Case Studies", href: "/case-studies" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-40 border-b border-transparent transition-colors duration-300" data-header>
  <div class="absolute inset-0 bg-white/90 backdrop-blur-md transition-opacity duration-300" data-header-bg></div>
  <div class="container-wide relative flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-2.5 text-navy-900" aria-label="ArcticAir Pro Services home">
      <span class="flex h-9 w-9 items-center justify-center rounded-md bg-navy-950 text-ice-300">
        <Icon name="temp" class="h-5 w-5" />
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.05rem] font-bold tracking-tight">ArcticAir Pro</span>
        <span class="text-[0.65rem] font-medium uppercase tracking-[0.14em] text-mist-500">Services</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {navLinks.map((link) => {
        const isActive = link.href === "/" ? currentPath === "/" : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              "link-underline text-sm font-medium transition-colors duration-200",
              isActive ? "text-navy-900" : "text-mist-600 hover:text-navy-900",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={business.phoneHref} class="flex items-center gap-2 text-sm font-semibold text-navy-800 hover:text-ice-600">
        <Icon name="phone" class="h-4 w-4" />
        {business.phoneDisplay}
      </a>
      <Button href="/book-service" size="sm" icon="arrow-right">Book AC Service</Button>
    </div>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-md text-navy-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <Icon name="menu" class="h-6 w-6" id="menu-icon-open" />
      <Icon name="close" class="hidden h-6 w-6" id="menu-icon-close" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden max-h-[calc(100vh-64px)] overflow-y-auto border-t border-mist-200 bg-white lg:hidden"
  >
    <nav class="container-wide flex flex-col gap-1 py-4" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-3 py-3 text-base font-medium text-navy-800 hover:bg-mist-100"
        >
          {link.label}
        </a>
      ))}
      <div class="mt-3 flex flex-col gap-3 border-t border-mist-200 pt-4">
        <a href={business.phoneHref} class="flex items-center gap-2 px-3 text-sm font-semibold text-navy-800">
          <Icon name="phone" class="h-4 w-4" />
          {business.phoneDisplay}
        </a>
        <Button href="/book-service" class="mx-3" icon="arrow-right">Book AC Service</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const headerBg = document.querySelector("[data-header-bg]") as HTMLElement | null;
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  function setScrolled() {
    if (!header) return;
    const scrolled = window.scrollY > 8;
    header.classList.toggle("border-mist-200", scrolled);
    if (headerBg) headerBg.style.opacity = scrolled ? "1" : "0.98";
  }

  function toggleMenu() {
    if (!menu || !toggle) return;
    const isOpen = menu.classList.contains("block");
    menu.classList.toggle("hidden", isOpen);
    menu.classList.toggle("block", !isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    document.body.style.overflow = !isOpen ? "hidden" : "";
  }

  function closeMenu() {
    if (!menu) return;
    menu.classList.add("hidden");
    menu.classList.remove("block");
    toggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", toggleMenu);
  window.addEventListener("scroll", setScrolled, { passive: true });
  document.addEventListener("astro:page-load", () => {
    setScrolled();
    closeMenu();
  });
  setScrolled();
</script>
