---
import type { Service } from "@data/services";
import Icon from "./Icon.astro";

interface Props {
  service: Service;
  index?: number;
}

const { service, index = 0 } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  class="card-surface group relative flex flex-col overflow-hidden p-6 transition-all duration-500 hover:-translate-y-1 hover:border-ice-300/60 hover:shadow-[0_20px_45px_-20px_rgba(15,31,54,0.35)] sm:p-7"
  data-reveal
  data-reveal-delay={index}
>
  <div class="flex items-start justify-between">
    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-navy-900 text-ice-200 transition-colors duration-500 group-hover:bg-accent-500 group-hover:text-navy-950">
      <Icon name={service.icon} class="h-6 w-6" />
    </div>
    {service.emergencyAvailable && (
      <span class="rounded-full bg-ice-50 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-navy-700">
        24/7
      </span>
    )}
  </div>

  <h3 class="mt-5 text-lg font-semibold text-navy-900">{service.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-mist-600">{service.shortDescription}</p>

  <div class="mt-6 flex items-center justify-between border-t border-mist-200 pt-4 text-sm">
    <span class="font-semibold text-navy-800">{service.priceLabel}</span>
    <span class="inline-flex items-center gap-1 font-semibold text-ice-600 transition-transform duration-300 group-hover:translate-x-1">
      Learn more
      <Icon name="arrow-right" class="h-3.5 w-3.5" />
    </span>
  </div>
</a>
