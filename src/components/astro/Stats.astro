---
/**
 * Wraps the AnimatedCounter React island for each stat, and clearly marks
 * the section as illustrative demo statistics.
 */
import { stats } from "@data/stats";
import AnimatedCounter from "../react/AnimatedCounter";
---

<div>
  <dl class="grid grid-cols-2 gap-6 sm:gap-8 lg:grid-cols-4">
    {stats.map((stat) => (
      <div class="border-l-2 border-ice-400/40 pl-4 sm:pl-5" data-reveal>
        <dt class="order-2 mt-1 text-xs font-medium uppercase tracking-wide text-ice-100/70 sm:text-sm">
          {stat.label}
        </dt>
        <dd class="order-1 font-mono text-3xl font-bold text-white sm:text-4xl lg:text-[2.75rem]">
          <AnimatedCounter
            client:visible
            value={stat.value}
            suffix={stat.suffix}
            prefix={stat.prefix}
            isDecimal={stat.isDecimal}
          />
        </dd>
      </div>
    ))}
  </dl>
  <p class="mt-6 text-xs text-ice-100/50">
    Figures shown are illustrative demo statistics for portfolio purposes.
  </p>
</div>
