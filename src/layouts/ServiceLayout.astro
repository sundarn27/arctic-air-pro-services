---
/**
 * Reusable layout that renders a complete service detail page from a single
 * `Service` record. Used by src/pages/services/[slug].astro so every service
 * page (AC Installation, AC Repair, AC Servicing, Deep Cleaning, Gas Refill,
 * Duct Cleaning, Commercial HVAC, Emergency Service) shares one implementation
 * instead of duplicated per-service markup.
 */
import Layout from "./Layout.astro";
import Breadcrumbs from "@components/astro/Breadcrumbs.astro";
import Button from "@components/astro/Button.astro";
import Icon from "@components/astro/Icon.astro";
import ServiceCard from "@components/astro/ServiceCard.astro";
import CTA from "@components/astro/CTA.astro";
import FAQ from "@components/astro/FAQ.astro";
import CallButton from "@components/astro/CallButton.astro";
import { siteMeta } from "@config/business";
import { getRelatedServices, type Service } from "@data/services";
import { buildServiceSchema, buildFaqSchema, buildBreadcrumbSchema } from "@utils/seo";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const related = getRelatedServices(service);

const canonical = new URL(`/services/${service.slug}`, siteMeta.siteUrl).toString();
const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services" },
  { name: service.title },
];

const structuredData = [
  buildServiceSchema(service),
  buildFaqSchema(service.faqs),
  buildBreadcrumbSchema(breadcrumbItems.map((b) => ({ name: b.name, url: b.href ? new URL(b.href, siteMeta.siteUrl).toString() : canonical }))),
];
---

<Layout
  title={`${service.title} | ${siteMeta.siteName}`}
  description={service.shortDescription}
  canonical={canonical}
  structuredData={structuredData}
>
  <!-- Service hero -->
  <section class="relative overflow-hidden bg-navy-950 pb-16 pt-10 sm:pb-20">
    <div class="technical-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="container-wide relative">
      <Breadcrumbs dark items={breadcrumbItems} />

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div data-reveal>
          <span class="eyebrow-dark">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
            {service.category.charAt(0).toUpperCase() + service.category.slice(1)} Service
          </span>
          <h1 class="mt-5 text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">{service.title}</h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-ice-100/75 sm:text-lg">{service.fullDescription}</p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button href="/book-service" size="lg" icon="arrow-right">Book This Service</Button>
            <CallButton variant="outline" />
          </div>

          <dl class="mt-8 flex flex-wrap gap-8 border-t border-white/10 pt-6">
            <div>
              <dt class="text-xs uppercase tracking-wide text-ice-100/50">Starting From</dt>
              <dd class="mt-1 text-xl font-bold text-white">{service.priceLabel}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-ice-100/50">Typical Duration</dt>
              <dd class="mt-1 text-xl font-bold text-white">{service.duration}</dd>
            </div>
            {service.emergencyAvailable && (
              <div>
                <dt class="text-xs uppercase tracking-wide text-ice-100/50">Availability</dt>
                <dd class="mt-1 text-xl font-bold text-white">24/7 Emergency</dd>
              </div>
            )}
          </dl>
        </div>

        <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 shadow-2xl" data-reveal data-reveal-delay="2">
          <img
            src={service.image}
            alt={`${service.title} illustration (demo graphic)`}
            class="h-full w-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Problems -->
  <section class="container-wide py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>Common Signs</span>
        <h2 class="mt-4 text-2xl font-semibold text-navy-900 sm:text-3xl">When you need {service.title.toLowerCase()}</h2>
        <ul class="mt-6 space-y-4">
          {service.problems.map((problem) => (
            <li class="flex items-start gap-3 rounded-lg border border-mist-200 bg-mist-50 p-4 text-sm text-navy-800">
              <Icon name="bolt" class="mt-0.5 h-4.5 w-4.5 flex-shrink-0 text-ice-600" />
              <span>{problem}</span>
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal data-reveal-delay="1">
        <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>Why It Matters</span>
        <h2 class="mt-4 text-2xl font-semibold text-navy-900 sm:text-3xl">Benefits of professional service</h2>
        <ul class="mt-6 space-y-4">
          {service.benefits.map((benefit) => (
            <li class="flex items-start gap-3 rounded-lg border border-mist-200 bg-white p-4 text-sm text-navy-800">
              <Icon name="check" class="mt-0.5 h-4.5 w-4.5 flex-shrink-0 text-accent-500" />
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-mist-50 py-16 sm:py-20">
    <div class="container-wide">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>Our Process</span>
        <h2 class="mt-4 text-2xl font-semibold text-navy-900 sm:text-3xl">How we deliver {service.title.toLowerCase()}</h2>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {service.process.map((step, i) => (
          <li class="card-surface p-6" data-reveal data-reveal-delay={i}>
            <span class="font-mono text-2xl font-bold text-ice-500">0{i + 1}</span>
            <h3 class="mt-3 text-base font-semibold text-navy-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-600">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pricing callout -->
  <section class="container-wide py-16 sm:py-20">
    <div class="card-surface flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10" data-reveal>
      <div>
        <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>Transparent Pricing</span>
        <p class="mt-4 text-2xl font-bold text-navy-900">{service.priceLabel} <span class="text-base font-medium text-mist-500">starting from</span></p>
        <p class="mt-2 max-w-md text-sm text-mist-600">Final pricing depends on inspection and actual service requirements. Emergency service pricing may vary.</p>
      </div>
      <Button href="/pricing" variant="secondary" icon="arrow-right">See Full Pricing</Button>
    </div>
  </section>

  <!-- FAQs -->
  <section class="bg-mist-50 py-16 sm:py-20">
    <div class="container-wide">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>FAQs</span>
        <h2 class="mt-4 text-2xl font-semibold text-navy-900 sm:text-3xl">Common questions about {service.title.toLowerCase()}</h2>
      </div>
      <div class="mx-auto mt-10 max-w-3xl">
        <FAQ items={service.faqs} />
      </div>
    </div>
  </section>

  <!-- Related services -->
  {related.length > 0 && (
    <section class="container-wide py-16 sm:py-20">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>Related Services</span>
        <h2 class="mt-4 text-2xl font-semibold text-navy-900 sm:text-3xl">You might also need</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
    </section>
  )}

  <CTA
    title={`Ready to book ${service.title}?`}
    description="Certified technicians, transparent pricing, and same-day availability."
    primaryLabel="Book This Service"
  />
</Layout>
